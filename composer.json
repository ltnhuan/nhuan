{
  "name": "eralms/enterprise",
  "description": "EraLMS Enterprise architecture scaffold for core, course studio, repository, and learning path.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/",
      "Database\\Factories\\": "database/factories/"
    }
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.0",
    "fakerphp/faker": "^1.24"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test:syntax": "php scripts/lint-php.php",
    "test:feature": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/phpunit --testsuite=Feature"
    ]
  }
}
